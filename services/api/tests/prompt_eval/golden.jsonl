{"id": "faithful_02", "category": "retrieval_faithfulness", "input": "资料里怎么讲黑洞的？", "mock": [{"type": "retrieval_faithfulness", "seed_texts": ["浮力是流体对物体向上的托力。", "阿基米德原理给出浮力大小。", "惯性只与物体质量有关。", "牛顿第二定律联系力与加速度。", "压强是压力与受力面积之比。", "密度是质量与体积之比。", "杠杆平衡取决于力矩。", "功是力在位移上的累积。", "机械能守恒要求只有重力做功。"], "query": "黑洞", "keywords": ["禁止凭文件名猜测", "编造", "如实"]}], "expect": {"must_include_any": ["没有找到", "未找到", "没有"]}}
{"id": "faithful_03", "category": "retrieval_faithfulness", "input": "查一下资料里的相对论内容", "mock": [{"type": "retrieval_faithfulness", "seed_texts": ["光合作用发生在叶绿体中。", "光反应产生ATP和NADPH。", "暗反应固定二氧化碳。", "细胞呼吸发生在线粒体。", "酶降低反应活化能。", "细胞膜具有选择透过性。", "DNA是主要的遗传物质。", "基因指导蛋白质合成。", "生态系统包含食物链。"], "query": "相对论", "keywords": ["禁止凭文件名猜测", "如实", "换关键词"]}], "expect": {"must_include_any": ["没有找到", "未找到", "没有"]}}
