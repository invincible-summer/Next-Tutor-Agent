{
  "id": "rule.precipitation_caco3.v1",
  "kind": "rule",
  "schema_version": 1,
  "priority": 90,
  "triggers": ["on_dispense", "on_pour", "on_stir", "on_wait"],
  "when": [
    {"op": "species_at_least", "vessel": "$target", "species": "ca_plus", "amount_umol": 1},
    {"op": "species_at_least", "vessel": "$target", "species": "co3_ion", "amount_umol": 1}
  ],
  "then": [
    {"op": "consume_min_ratio", "vessel": "$target", "pairs": [["ca_plus", 1], ["co3_ion", 1]]},
    {"op": "transfer_to_solid", "vessel": "$target", "species": "caco3", "from_consumed": true, "ratio_to_consumed": 1000}
  ],
  "limits": {"max_firings_per_evaluation": 8},
  "model_scope": "cacl2_na2co3_dilute_v1",
  "public_note": {
    "zh": "钙离子与碳酸根按 1:1 结合生成白色碳酸钙沉淀；仅限氯化钙-碳酸钠限定体系。",
    "en": "Calcium and carbonate ions combine 1:1 into white CaCO₃ precipitate; limited to the CaCl₂–Na₂CO₃ system."
  }
}
