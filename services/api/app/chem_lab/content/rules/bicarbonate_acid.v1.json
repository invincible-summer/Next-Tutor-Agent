{
  "id": "rule.bicarbonate_acid.v1",
  "kind": "rule",
  "schema_version": 1,
  "priority": 90,
  "triggers": ["on_dispense", "on_pour", "on_stir", "on_wait"],
  "when": [
    {"op": "species_at_least", "vessel": "$target", "species": "h_plus", "amount_umol": 1},
    {"op": "species_at_least", "vessel": "$target", "species": "nahco3", "amount_umol": 1}
  ],
    "then": [
    {"op": "consume_min_ratio", "vessel": "$target", "pairs": [["h_plus", 1], ["nahco3", 1]], "cap_umol": 200},
    {"op": "produce", "vessel": "$target", "species": "na_plus", "from_consumed": true, "ratio_to_consumed": 1000},
    {"op": "produce", "vessel": "$target", "species": "water", "from_consumed": true, "ratio_to_consumed": 1000},
    {"op": "transfer_to_gas", "vessel": "$target", "species": "co2", "from_consumed": true, "ratio_to_consumed": 1000}
  ],
  "limits": {"max_firings_per_evaluation": 2},
  "model_scope": "hcl_nahco3_v1",
  "public_note": {
    "zh": "碳酸氢钠遇酸按 1:1 放出二氧化碳气体（速率受限，持续冒泡）；模型忽略碳酸平衡。",
    "en": "Bicarbonate reacts with acid 1:1 releasing CO₂ (rate-limited, sustained bubbling); carbonate equilibria ignored."
  }
}
