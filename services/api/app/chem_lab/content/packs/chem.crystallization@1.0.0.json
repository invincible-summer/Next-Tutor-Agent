{
  "_concepts": {
    "concept.solubility_temperature": {
      "body": {
        "en": "Most solids dissolve better when hot. KNO₃ is dramatic: at 80 °C about five times as much dissolves as at 20 °C. Cooling a hot saturated solution forces the excess out as crystals. The lab interpolates a solubility table — a teaching approximation.",
        "zh": "大多数固体的溶解度随温度升高而增大。硝酸钾尤其明显：80 °C 时能溶解的量约为 20 °C 时的五倍。热饱和溶液降温后，装不下的溶质就会析出晶体。实验台用溶解度表逐温度插值，属教学近似。"
      },
      "equation": "",
      "id": "concept.solubility_temperature",
      "kind": "concept",
      "misconception": null,
      "prerequisites": [
        "concept.molarity"
      ],
      "schema_version": 1,
      "title": {
        "en": "Solubility and temperature",
        "zh": "溶解度与温度"
      }
    },
    "concept.thermal_safety": {
      "body": {
        "en": "Liquids warm as they absorb heat and cool toward room temperature off the heat (faster when hotter). This lab warns at 60 °C and safety-locks at 95 °C — after a lock you inspect the reason and restart from a checkpoint, a fuse only a virtual lab can offer.",
        "zh": "液体吸热升温、离火后向环境散热（温度越高降得越快）。本实验台在 60 °C 给出过热提示、95 °C 触发安全锁定——锁定后只能查看原因并从检查点重来，这是虚拟实验特有的“保险丝”。"
      },
      "equation": "Q = c × m × ΔT",
      "id": "concept.thermal_safety",
      "kind": "concept",
      "misconception": null,
      "prerequisites": [],
      "schema_version": 1,
      "title": {
        "en": "Heating and thermal safety",
        "zh": "加热与热安全"
      }
    }
  },
