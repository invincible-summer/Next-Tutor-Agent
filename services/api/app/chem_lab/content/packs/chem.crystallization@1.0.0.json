      "hint_ladder": [
        {
          "en": "Take one last reading with the thermometer.",
          "zh": "用温度计做最后一次测量。"
        }
      ],
      "id": "step.final_measure",
      "objective": {
        "en": "Read the final temperature after crystallization and compare with the dissolving temperature.",
        "zh": "读取结晶完成后的最终温度，和溶解时的高温做对比。"
      },
      "title": {
        "en": "Record the final temperature",
        "zh": "记录末温"
      }
    }
