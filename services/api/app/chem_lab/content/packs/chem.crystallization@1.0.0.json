      "hint_ladder": [
        {
          "en": "Stirring while heating speeds dissolving a lot.",
          "zh": "边加热边搅拌，溶解会快很多。"
        },
        {
          "en": "Solubility rises with temperature — progress is clear above 60 °C.",
          "zh": "溶解度随温度升高而增大，60 °C 以上进步明显。"
        },
        {
          "en": "Do not push to 95 °C — that triggers the safety lock.",
          "zh": "别把温度推到 95 °C，会触发安全锁定。"
        }
      ],
      "id": "step.dissolve",
      "objective": {
        "en": "Heat and stir until all the KNO₃ at the bottom dissolves (around 70 °C).",
        "zh": "加热并搅拌，让烧杯底部的硝酸钾固体全部溶解（约需 70 °C）。"
      },
      "title": {
        "en": "Heat to dissolve",
        "zh": "加热溶解"
      }
    },
    {
      "accepted_commands": [
        "wait",
        "stir",
        "measure"
      ],
      "concept_ids": [
        "concept.solubility_temperature"
      ],
      "expected_observations": [
        "precipitate_visible"
      ],
      "hint_ladder": [
        {
          "en": "Be patient while it cools — the colder, the less can stay dissolved.",
          "zh": "耐心等待降温——温度越低，能溶解的越少。"
        },
        {
          "en": "The crystals are not new stuff — still the same KNO₃.",
          "zh": "析出的不是“新物质”，还是原来的硝酸钾。"
        }
      ],
      "id": "step.crystallize",
      "objective": {
        "en": "Stop heating and let the solution cool slowly; watch white crystals come back.",
        "zh": "停止加热，让溶液慢慢冷却，观察白色晶体重新析出。"
      },
      "title": {
        "en": "Cool to crystallize",
        "zh": "冷却析晶"
      }
    },
    {
      "accepted_commands": [
        "measure"
      ],
