{
  "_concepts": {
    "concept.filtration": {
      "body": {
        "en": "Filtration separates by particle size: the filtrate carries dissolved ions through while the residue is retained. Letting the precipitate settle first makes pouring cleaner and filtering faster.",
        "zh": "过滤利用颗粒大小差异分离固液：液体（滤液）带着溶解的离子通过，固体（滤渣）被截留。先让沉淀静置沉降再过滤，可以倒得更清、滤得更快。"
      },
      "equation": "",
      "id": "concept.filtration",
      "kind": "concept",
      "misconception": {
        "en": "Filtration cannot remove dissolved ions — they are far smaller than the pores.",
        "zh": "过滤不能把溶解的离子“滤掉”——它们比滤孔小得多。"
      },
      "prerequisites": [
        "concept.precipitation"
      ],
      "schema_version": 1,
      "title": {
        "en": "Filtration",
        "zh": "过滤分离"
      }
    },
    "concept.precipitation": {
      "body": {
        "en": "Mixing two soluble salts can precipitate an insoluble ion pair. CaCl₂ + Na₂CO₃ yields white CaCO₃ while Na⁺ and Cl⁻ spectate. Turbidity comes from suspended fine particles that settle into a layer on standing.",
        "zh": "两种可溶盐混合时，若某种离子组合难溶，就会析出固体沉淀。氯化钙与碳酸钠混合生成白色碳酸钙，钠离子和氯离子留在溶液中旁观。浑浊来自悬浮的细小颗粒，静置后会沉降分层。"
      },
      "equation": "Ca²⁺ + CO₃²⁻ → CaCO₃↓",
      "id": "concept.precipitation",
      "kind": "concept",
      "misconception": {
        "en": "Cloudiness is not 'fog' — it is suspended solid particles forming.",
        "zh": "变浑浊不是“起了雾”，而是生成了悬浮的固体微粒。"
      },
      "prerequisites": [],
      "schema_version": 1,
      "title": {
        "en": "Precipitation",
        "zh": "沉淀反应"
      }
    }
  },
