      "hint_ladder": [
        {
          "en": "Use “wait” to let time pass.",
          "zh": "使用“等待”让时间流逝。"
        },
        {
          "en": "Stirring resuspends the bed — hold off for this step.",
          "zh": "搅拌会把沉淀重新搅起来——这一步先别搅。"
