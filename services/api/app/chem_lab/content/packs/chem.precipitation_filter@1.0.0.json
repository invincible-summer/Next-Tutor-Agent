      "id": "step.mix",
      "objective": {
        "en": "Measure about 20 mL of sodium carbonate and add it to the calcium chloride; watch the precipitate form.",
        "zh": "量取约 20 mL 碳酸钠溶液，加入氯化钙溶液中，观察沉淀生成。"
      },
      "title": {
        "en": "Mix the solutions",
        "zh": "混合两种溶液"
