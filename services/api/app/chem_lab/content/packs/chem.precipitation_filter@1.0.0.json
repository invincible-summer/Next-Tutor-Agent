      "id": "step.settle",
      "objective": {
        "en": "Wait about 15 s without stirring; watch the suspension settle into a bottom layer.",
        "zh": "静置约 15 秒不要搅拌，观察浑浊液逐渐沉降、底部出现沉淀层。"
      },
      "title": {
        "en": "Let it settle",
        "zh": "静置分层"
