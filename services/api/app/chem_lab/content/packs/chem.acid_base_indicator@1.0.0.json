{
  "_concepts": {
    "concept.indicator": {
      "body": {
        "en": "Phenolphthalein is a dye that is colorless below about pH 8.2 and pink above. It only reports a pH range and does not enter the stoichiometry; the teaching model approximates the gradual transition with two bands.",
        "zh": "酚酞本身是一种弱酸型染料，在 pH 约 8.2 以下无色，以上变为粉红。它只“报告”pH 区间，不参与中和计量；教学模型用两个色带近似真实的渐变。"
      },
      "equation": "",
      "id": "concept.indicator",
      "kind": "concept",
      "misconception": null,
      "prerequisites": [
        "concept.ph_scale"
      ],
      "schema_version": 1,
      "title": {
        "en": "Indicator color change",
        "zh": "指示剂变色"
      }
    },
    "concept.neutralization": {
      "body": {
        "en": "H⁺ and OH⁻ combine 1:1 into water, releasing heat (≈57 kJ/mol teaching approximation). During titration added base is consumed and pH climbs slowly; near the equivalence point a small addition swings pH sharply — that is the endpoint.",
        "zh": "H⁺ 与 OH⁻ 按 1:1 结合成水并放热（教学近似约 57 kJ/mol）。滴定时加入的碱先被酸“吃掉”，pH 缓慢爬升；接近等量点时少量碱就能让 pH 大幅跳动，这就是终点的由来。"
      },
      "equation": "H⁺ + OH⁻ → H₂O",
      "id": "concept.neutralization",
      "kind": "concept",
      "misconception": {
        "en": "Neutralization is not covering the acid up — H⁺ is actually consumed.",
        "zh": "中和不是把酸“盖住”，而是 H⁺ 真的被消耗掉了。"
      },
      "prerequisites": [
        "concept.ph_scale"
      ],
      "schema_version": 1,
      "title": {
        "en": "Neutralization",
        "zh": "中和反应"
      }
    },
    "concept.ph_scale": {
      "body": {
        "en": "pH is a logarithmic scale of hydrogen-ion concentration: one unit means a tenfold change. Near 7 is neutral; lower is acidic, higher basic. This lab uses the dilute strong-acid/strong-base approximation, no activity or weak-acid equilibria.",
        "zh": "pH 用对数刻度表示氢离子浓度：每差 1，浓度差 10 倍。pH 7 附近为中性，越小越酸，越大越碱。本实验台用稀溶液浓度近似（强酸强碱模型），不讨论活度与弱酸平衡。"
      },
      "equation": "pH = −log₁₀[H⁺]",
      "id": "concept.ph_scale",
      "kind": "concept",
      "misconception": null,
      "prerequisites": [],
      "schema_version": 1,
      "title": {
        "en": "pH, acids and bases",
        "zh": "pH 与酸碱"
      }
    }
  },
