      "id": "step.initial",
      "objective": {
        "en": "Measure the starting temperature of the water.",
        "zh": "用温度计测量烧杯中水的初始温度。"
      },
      "title": {
        "en": "Measure the start temperature",
        "zh": "测初始温度"
