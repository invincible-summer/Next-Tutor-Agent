      "expected_observations": [
        "steam_visible"
      ],
      "hint_ladder": [
        {
          "en": "Heat: the device is the hotplate, the target the beaker.",
          "zh": "加热命令：器材选电热板，目标是烧杯。"
        },
        {
          "en": "Measure while heating to follow the curve.",
          "zh": "可以边加热边测温，跟踪升温曲线。"
        },
        {
          "en": "A warning appears near 60 °C; 95 °C triggers the safety lock.",
          "zh": "接近 60 °C 会有过热提示；95 °C 会触发安全锁定。"
        }
      ],
      "id": "step.heat",
      "objective": {
        "en": "Heat the beaker on the hotplate; watch the temperature climb and steam appear, and note the 60 °C warning.",
        "zh": "把烧杯放到电热板上加热，观察温度上升与蒸汽出现；留意 60 °C 的过热提示。"
      },
      "title": {
        "en": "Heat and observe",
        "zh": "加热观察"
      }
    },
    {
      "accepted_commands": [
        "wait",
        "measure"
      ],
      "concept_ids": [
        "concept.thermal_safety"
      ],
      "expected_observations": [
        "measured_temperature"
      ],
      "hint_ladder": [
        {
          "en": "Wait a while so the water loses heat to the room.",
          "zh": "等待一段时间让水向环境散热。"
        },
        {
          "en": "Hotter water cools faster — a feature of lumped cooling.",
          "zh": "温度越高降得越快——这是集总散热的特点。"
        }
      ],
      "id": "step.cool",
      "objective": {
        "en": "Stop heating, wait for cooling, then measure again and compare.",
        "zh": "停止加热等待冷却，再测一次温度，比较前后读数。"
      },
      "title": {
        "en": "Cool and record",
        "zh": "冷却记录"
      }
    }
  ],
