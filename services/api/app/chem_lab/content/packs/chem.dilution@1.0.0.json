{
  "_concepts": {
    "concept.dilution": {
      "body": {
        "en": "Dilution adds solvent only; the amount of solute is conserved, so color fades but the quantity stays. Below the visibility threshold the color 'disappears' — the solute is still there, just too dilute to see.",
        "zh": "稀释只加入溶剂，溶质的总量不变，所以颜色会变浅但物质的量不变。当浓度低于可见阈值时颜色“消失”——溶质还在，只是稀到看不见了。"
      },
      "equation": "c₁V₁ = c₂V₂",
      "id": "concept.dilution",
      "kind": "concept",
      "misconception": {
        "en": "Color vanishing is not solute vanishing.",
        "zh": "颜色消失不等于溶质消失。"
      },
      "prerequisites": [
        "concept.molarity"
      ],
      "schema_version": 1,
      "title": {
        "en": "Conservation in dilution",
        "zh": "稀释守恒"
      }
    },
    "concept.molarity": {
      "body": {
        "en": "Concentration is the amount of solute per unit volume. In this lab 1 µmol/µL equals 1 mol/L, so 10 mL of 0.1 mol/L carries 1000 µmol. A pipette measures by volume; solute moves in proportion.",
        "zh": "浓度表示单位体积溶液中溶质的量。实验台里 1 µmol/µL 恰好等于 1 mol/L，所以量取 10 mL 0.1 mol/L 的溶液就是取走 1000 µmol 溶质。移液管按体积量取，溶质的量随体积等比例转移。"
      },
      "equation": "n = c × V",
      "id": "concept.molarity",
      "kind": "concept",
      "misconception": {
        "en": "How much you draw and how concentrated it is are different things: equal volumes at different concentrations carry different amounts.",
        "zh": "“吸多少”和“吸多浓”是两回事：同样的体积，浓度不同，取走的物质的量就不同。"
      },
      "prerequisites": [],
      "schema_version": 1,
      "title": {
        "en": "Molar concentration",
        "zh": "物质的量浓度"
      }
    }
  },
