      "precipitate.white": {"zh": "白色沉淀", "en": "white precipitate"}
    },
    "color_hex": {
      "clear": "#dceaf4",
      "precipitate.white": "#f8fafc"
    },
    "textures": {
      "powder": {"zh": "细腻粉末", "en": "fine powder"},
      "layer": {"zh": "沉降分层", "en": "settled layer"}
    }
  },
  "ph_model": "none",
  "observation_visibility": {
    "guided": ["precipitate_visible", "turbid_visible", "sediment_layer", "filtered"],
    "explore": ["precipitate_visible", "turbid_visible", "sediment_layer", "filtered"],
    "self_check": ["precipitate_visible", "filtered"]
  }
}
