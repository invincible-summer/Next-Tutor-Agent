{
  "id": "chem.precipitation_filter",
  "kind": "experiment",
  "schema_version": 1,
  "pack_version": "1.0.0",
  "title": {"zh": "沉淀反应与过滤", "en": "Precipitation and filtration"},
  "summary": {
    "zh": "把碳酸钠溶液加入氯化钙溶液，观察白色碳酸钙沉淀生成、浑浊液静置分层，再过滤分离固体与滤液。",
    "en": "Add sodium carbonate to calcium chloride, watch white CaCO₃ precipitate and the cloudy mixture settle into layers, then filter to separate solid from filtrate."
  },
  "audience": ["middle_school", "high_school_intro"],
  "model_scope": {
    "zh": "仅限氯化钙-碳酸钠限定体系，按 1:1 计量生成沉淀；不模拟其他盐类组合与沉淀溶解平衡。",
    "en": "Limited to the CaCl₂–Na₂CO₃ system with 1:1 stoichiometry; other salt combinations and solubility equilibria are out of scope."
  },
  "modes": ["guided", "explore", "self_check"],
  "equipment": ["reagent_bottle", "beaker.small", "conical_flask", "pipette", "stir_rod"],
  "species": ["water", "ca_plus", "co3_ion", "caco3", "na_plus", "cl_minus"],
  "rule_ids": ["rule.precipitation_caco3.v1"],
  "concept_ids": ["concept.precipitation", "concept.filtration"],
  "starting_state": {
    "room_temperature_milli_c": 25000,
    "slots": [
      {"id": "b1", "x": 30, "y": 90, "w": 130, "h": 190},
      {"id": "b3", "x": 340, "y": 90, "w": 130, "h": 190},
      {"id": "b4", "x": 495, "y": 90, "w": 130, "h": 190},
      {"id": "f1", "x": 30, "y": 400, "w": 170, "h": 260},
      {"id": "f2", "x": 230, "y": 400, "w": 170, "h": 260}
    ],
    "vessels": [
      {"id": "cacl2-beaker", "kind": "beaker.small", "slot": "f1", "capacity_uL": 250000,
       "volume_uL": 20000, "contents": {"ca_plus": 10000, "cl_minus": 20000},
       "label": {"zh": "0.5 mol/L 氯化钙 20 mL", "en": "20 mL of 0.5 mol/L CaCl₂"}},
      {"id": "na2co3-stock", "kind": "reagent_bottle", "slot": "b1", "capacity_uL": 500000,
       "volume_uL": 100000, "contents": {"co3_ion": 50000, "na_plus": 100000},
       "label": {"zh": "0.5 mol/L 碳酸钠", "en": "0.5 mol/L Na₂CO₃"}},
      {"id": "receiver", "kind": "conical_flask", "slot": "f2", "capacity_uL": 250000,
       "label": {"zh": "接收瓶", "en": "Receiving flask"}}
    ],
    "equipment": [
      {"id": "pipette-1", "kind": "pipette", "slot": "b3"},
      {"id": "rod-1", "kind": "stir_rod", "slot": "b4"}
    ]
  },
  "reagents": [
    {"id": "reagent.na2co3", "vessel_id": "na2co3-stock", "species": ["co3_ion", "na_plus"],
     "description": {"zh": "提供碳酸根的可溶盐溶液。", "en": "Soluble salt supplying carbonate."},
     "concentration_label": {"zh": "0.5 mol/L", "en": "0.5 mol/L"}}
  ],
  "procedure": [
    {
      "id": "step.mix",
      "title": {"zh": "混合两种溶液", "en": "Mix the solutions"},
      "objective": {"zh": "量取约 20 mL 碳酸钠溶液，加入氯化钙溶液中，观察沉淀生成。", "en": "Measure about 20 mL of sodium carbonate and add it to the calcium chloride; watch the precipitate form."},
      "accepted_commands": ["aspirate", "dispense", "pour"],
      "expected_observations": ["precipitate_visible"],
      "hint_ladder": [
        {"zh": "用移液管取 20 mL 碳酸钠溶液。", "en": "Use the pipette for 20 mL of Na₂CO₃."},
        {"zh": "加入烧杯后立刻观察：白色固体就是碳酸钙。", "en": "Watch right after adding: the white solid is CaCO₃."}
      ],
      "concept_ids": ["concept.precipitation"]
    },
    {
      "id": "step.settle",
      "title": {"zh": "静置分层", "en": "Let it settle"},
      "objective": {"zh": "静置约 15 秒不要搅拌，观察浑浊液逐渐沉降、底部出现沉淀层。", "en": "Wait about 15 s without stirring; watch the suspension settle into a bottom layer."},
      "accepted_commands": ["wait"],
      "expected_observations": ["sediment_layer"],
      "hint_ladder": [
        {"zh": "使用“等待”让时间流逝。", "en": "Use “wait” to let time pass."},
        {"zh": "搅拌会把沉淀重新搅起来——这一步先别搅。", "en": "Stirring resuspends the bed — hold off for this step."}
      ],
      "concept_ids": ["concept.precipitation"]
    },
    {
      "id": "step.filter",
      "title": {"zh": "过滤分离", "en": "Filter"},
      "objective": {"zh": "把混合液过滤到接收瓶中，比较滤液与留在原烧杯中的固体。", "en": "Filter the mixture into the receiving flask and compare the filtrate with the residue."},
      "accepted_commands": ["filter"],
      "expected_observations": ["filtered"],
      "hint_ladder": [
        {"zh": "过滤操作：来源选烧杯，接收选锥形瓶。", "en": "Filter: source is the beaker, apparatus is the flask."},
        {"zh": "注意滤液是澄清的——溶解的离子穿过了滤纸。", "en": "The filtrate is clear — dissolved ions passed through."}
      ],
      "concept_ids": ["concept.filtration"]
    }
  ],
  "goals": [
    {"id": "goal.separate", "title": {"zh": "生成并分离沉淀", "en": "Form and separate the precipitate"},
     "requires_observations": ["precipitate_visible", "filtered"]}
  ],
  "predictions": [
    {
      "id": "pred.filtrate",
      "step_id": "step.filter",
      "question": {"zh": "过滤后的滤液中主要剩下什么？", "en": "What mainly remains in the filtrate?"},
      "options": [
        {"id": "a", "label": {"zh": "钠离子和氯离子", "en": "Sodium and chloride ions"}, "correct": true},
        {"id": "b", "label": {"zh": "钙离子和碳酸根", "en": "Calcium and carbonate ions"}},
        {"id": "c", "label": {"zh": "碳酸钙", "en": "Calcium carbonate"}},
        {"id": "d", "label": {"zh": "什么都不剩", "en": "Nothing at all"}}
      ]
    }
  ],
  "safety_profile": {
    "id": "teaching_virtual_irritant_v1",
    "warn_temperature_milli_c": 60000,
    "lock_temperature_milli_c": 95000,
    "notes": {"zh": "虚拟盐溶液按刺激性液体对待：倾倒时对准容器，避免洒出容量上限。", "en": "Treat virtual salt solutions as irritants: pour carefully and do not overfill."}
  },
  "visual_theme": {
