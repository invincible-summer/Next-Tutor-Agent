!chat_history/library/
chat_history/library/*
!chat_history/library/public.json
!chat_history/library/public.textbooks.json
!chat_history/library/data/
chat_history/library/data/*
!chat_history/library/data/public/
!chat_history/library/data/public/**

# Only the public textbook graph is versioned. The root graph and vector DB can
# contain learned/private data and must remain deployment-local and ignored.
/knowledge/*
!/knowledge/custom/
/knowledge/custom/*
!/knowledge/custom/public/
!/knowledge/custom/public/**
!/knowledge/public_vector_artifacts/
!/knowledge/public_vector_artifacts/**

# Common local research/download scratch directories; public textbooks belong
# in the public library namespace above instead.
/downloads/
/papers/
/论文下载/
*:Zone.Identifier
*.part
*.crdownload
*.download
*.sqlite
*.sqlite3
*.db
# P10 voice local assets: MeloTTS checkout, model weights, and runtime caches.
# (install via deploy/install_voice.sh). These are deployment-local artifacts,
# not project content and never user data. The parent-directory rules are the
# primary guard; the extension rules are defense in depth if a cache is moved
# below either deployment-only root.
/backend/vendor/
/backend/models/
/backend/voice_sidecar/.venv/
/backend/.cache/
/backend/.huggingface/
# Weight-specific formats are never repository source. Keep generic *.bin
# scoped to the deployment roots above because unrelated fixtures may use it.
*.ckpt
*.gguf
*.onnx
*.pt
*.pth
*.safetensors
*.tflite
*.mlmodel
*.mlpackage
*.params
*.weights
/backend/vendor/**/*.bin
/backend/models/**/*.bin
# Runtime per-account state. The demo account's showcase files are re-included
# in the demo block at the bottom of this file; everything else stays ignored.
students/*
users/

# Per-user notes vaults are runtime state (M-Notes). Anchored to the repo
# root so frontend source dirs like components/pages/notes/ stay tracked.
/notes/*

node_modules/
.next/
out/
.pnpm-store/

.vscode/
.idea/
.DS_Store
*.swp
.zcode/

# --- Demo account showcase data (example@example.com / usr_12e410b4e2) -----
# Deliberately versioned as product-demo content (see AGENTS.md / DESIGN.md).
# Zones whose path carries the account id are whitelisted as a whole below
# (notes vault, students/* state, per-account library files/uploads), so any
# future file for this account is tracked automatically. Chats and workspaces
# CANNOT be wildcarded: their filenames carry only timestamp+title (the
# account id lives inside the JSON), so a glob there would also commit other
# users' private sessions -- they stay exact-file negations.
# Transcript sidecars of the showcase sessions below are tracked as exact
# negations too (plain message turns, same format as the tracked trash
# payloads); every other account's transcripts stay ignored, and backend
# traces (raw chain-of-thought) stay ignored for ALL accounts.
# G6 migration (plan §16): legacy evaluation inputs (learning_records /
# quiz_recent / events) were migrated into the learning-evidence journal and
# deleted; students/usr_12e410b4e2.learning_evidence.jsonl is the tracked
# source of truth now (enforced by scripts/check_repository_invariants.py).
# On fresh clones run:  python deploy/seed_demo_account.py
!/notes/usr_12e410b4e2/
!students/usr_12e410b4e2*
!chat_history/library/usr_12e410b4e2*.json
!chat_history/library/data/usr_12e410b4e2/
!chat_history/library/data/usr_12e410b4e2/**
!chat_history/workspaces/
chat_history/workspaces/*
# 2026-09 showcase set: learning_evidence.jsonl references workspaces
# ws_20260916_012038/012039 and the Sep-16/17 sessions below; without them the
# /memory concept views and /assessment scope resolution break on fresh clones.
# The recycle-bin block keeps the demo account's soft-deleted sessions (path
# carries the account id) while every other account's trash stays ignored.
