# Next-Tutor-Agent configuration. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit real keys; `chmod 600 .env` recommended.
#
# 本文件只保留密钥 / URL / 模型名 / 部署开关。上下文窗口、温度、步数等
# 运行参数已内置默认值：管理页「运行参数」在线调整（热更新，无需重启），
# 环境变量仍可作为初始默认覆盖。完整参数清单见 services/api/app/core/config.py
# 与 docs/DESIGN.md。
#
# 运行数据根（默认 <repo>/.runtime/data，可指向持久化路径如 /var/lib/next-tutor-agent/data）
# NEXT_TUTOR_DATA_DIR=
#
# 端点必须是 OpenAI 兼容的 Chat Completions 接口（OpenAI Python SDK）；
# 网络请求为直连：后端忽略 HTTP_PROXY / HTTPS_PROXY / ALL_PROXY。

# --- LLM（唯一通道：聊天/推理/出题/课堂/视觉 OCR 共用，请选多模态模型；
#      模型无视觉能力时 OCR 自动回退本地 tesseract） ---
# 方案 A：DeepSeek 官方（platform.deepseek.com；2026-09 实测可用
# deepseek-flash / deepseek-v4-pro）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-flash
# 方案 B：任一 OpenAI 兼容端点（网关/中转），三行换成对应值即可
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=

# --- AI 生图（服务端统一选择；前端不保存密钥，也不选择模型） ---
# 协议：openai_compatible | dashscope | seedream
# OpenAI-compatible 可接入任意第三方兼容服务，IMAGE_API_MODEL 原样透传。
# IMAGE_API_ENABLED=0
# IMAGE_API_PROVIDER=custom
# IMAGE_API_PROTOCOL=openai_compatible
# IMAGE_API_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=
# IMAGE_API_MODEL=gpt-image-1
# IMAGE_API_TIMEOUT_SECONDS=120
# IMAGE_API_SUPPORTS_REFERENCE=1
# 旧部署可继续使用 OPENAI_API_KEY / DASHSCOPE_API_KEY / SEED_API_KEY，
# 但需同时打开 IMAGE_API_ENABLED=1；新部署建议只配置上面的 IMAGE_API_*。

# 教学题图：V1/V2 组件构图，V3 可参考素材自由创作安全 SVG
QUIZ_SVG_ENABLED=1
QUIZ_DIAGRAM_MODE=components
# v1 / shadow / v2 / v3；shadow 保留旧交付并旁路评测，新题图整体验收后按部署切换
QUIZ_ILLUSTRATION_PIPELINE=shadow
QUIZ_ILLUSTRATION_VISUAL_REVIEW=active
# 必须实测配置的模型支持 image_url；不支持时必要图不发布
LLM_SUPPORTS_IMAGES=0
QUIZ_ILLUSTRATION_MAX_CALLS=10
QUIZ_ILLUSTRATION_MAX_REPAIRS=2
QUIZ_ILLUSTRATION_DEADLINE_SECONDS=120
# 文字出题预算：V2/V3 配图使用上方独立预算，批量图片并发 2
ASSESSMENT_GENERATION_MAX_ATTEMPTS=2
ASSESSMENT_GENERATION_MAX_CALLS=6
ASSESSMENT_GENERATION_DEADLINE_SECONDS=90
LLM_MODEL=deepseek-flash

# --- 课堂功能 key（不需要对应功能可留空） ---
# 联网检索（无 key 即不可用，不伪联网）
TAVILY_API_KEY=
# 图片（顺序固定，可只配一个）
PEXELS_API_KEY=
PIXABAY_API_KEY=
# 课堂总闸：关闭时能力端点可读、生成类端点返回 classroom_disabled
CLASSROOM_ENABLED=1

# --- 管理员引导账号（启动时确保存在且 role=admin；仅首次/缺失时生效） ---
# 生产必改：AUTH_MODE=1 下弱默认值（change-me 等）或 <10 字符会拒绝启动。
ADMIN_EMAIL=administrator@example.com
ADMIN_PASSWORD=change-me

# --- 服务器 ---
# 默认只绑回环地址（含 WSL2 下从 Windows 访问 localhost 的场景）；需要
# 局域网设备直连时才显式改为 0.0.0.0（生产应经 nginx/TLS 反代，不直出）。
API_HOST=127.0.0.1
API_PORT=8000

# --- 可选（默认关闭/内置；按需取消注释） ---
# 本地语音 sidecar（MeloTTS，deploy/self-hosted/install_voice.sh 安装；默认 off）
# VOICE_TTS_PROVIDER=melo
# VOICE_TTS_BASE_URL=http://127.0.0.1:8130
# 课堂云端 TTS / 服务端 STT（Azure、讯飞或 Deepgram；默认关闭）
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# IFLYTEK_APP_ID=
# IFLYTEK_API_KEY=
# IFLYTEK_API_SECRET=
# DEEPGRAM_API_KEY=
# CLASSROOM_TTS_CLOUD_PROVIDER=azure
# 服务端语音转写：off | stub | azure | iflytek | deepgram | auto
# SPEECH_STT_PROVIDER=off
# 生产部署必改：AUTH_MODE=1 时默认 JWT secret 会拒绝启动
# AUTH_MODE=1
# AUTH_JWT_SECRET=<独立随机密钥>
# CORS_ORIGINS=https://your.domain
# 企业模式 Web 刷新 cookie（HttpOnly edu_refresh）默认 Secure；仅纯 http
# 本地联调（非 localhost）需要显式关闭。
# AUTH_REFRESH_COOKIE_SECURE=1

# --- 企业持久化（全部可选；未设置 DATABASE_URL 时保持文件模式，行为不变） ---
# PostgreSQL（异步驱动 asyncpg；设置后启用多实例/多 worker 模式）
# DATABASE_URL=postgresql+asyncpg://next_tutor:change-me@127.0.0.1:5432/next_tutor
# 缓存层（分布式限流/single-flight/短缓存；未设置回退进程内实现）。
# 服务端为 Valkey（BSD-3，ADR-0016）；REDIS_URL 为旧名，保留一版兼容。
# CACHE_URL=redis://127.0.0.1:6379/0
# 对象存储（默认 local：落 NEXT_TUTOR_DATA_DIR 内 object-store/）
# OBJECT_STORE_BACKEND=local
# OBJECT_STORE_ROOT=
# S3 兼容后端（ADR-0018，boto3）：AWS S3 / 自建 MinIO 等；四项缺一即拒绝启动
# OBJECT_STORE_BACKEND=s3
# OBJECT_STORE_ENDPOINT=https://s3.amazonaws.com
# OBJECT_STORE_BUCKET=next-tutor
# OBJECT_STORE_ACCESS_KEY=
# OBJECT_STORE_SECRET_KEY=
# OBJECT_STORE_REGION=us-east-1
# SSE-S3 服务端加密默认开启；端点不支持时显式关闭
# OBJECT_STORE_S3_SSE=AES256
# OBJECT_STORE_S3_FORCE_PATH_STYLE=1
# OBJECT_STORE_TIMEOUT_SECONDS=30
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_CONTAINER=

# --- 可观测性（可选，默认关闭；需安装 requirements-observability.txt） ---
# OTEL_TRACES_ENABLED=0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# OTEL_SERVICE_NAME=next-tutor-api

# --- Temporal durable workflow lane（可选，ADR-0013；默认关闭） ---
# 未设置 TEMPORAL_ADDRESS 时各域保持进程内任务执行（file/self-hosted 模式）。
# 设置后需另跑 worker 进程：cd services/api && python worker.py
# （systemd 模板 deploy/self-hosted/edu-worker.service；维护定时 Schedule
# 由 worker 启动幂等注册；队列划分与双模式语义见 docs/architecture/
# backend-runtime.md 与 docs/development/enterprise-infra.md）。
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=default
