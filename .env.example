# ============================================================================
# Edu_Agent 环境变量模板 | Edu_Agent environment configuration
# ============================================================================
#
# 使用方法 | Getting started:
#   1. 复制本文件为 .env 并填入你自己的值
#      Copy this file to `.env` and fill in your values.
#   2. .env 已被 gitignore(见 .gitignore)——切勿提交真实密钥
#      `.env` is gitignored (see .gitignore) — never commit real keys.
#   3. 本文件包含 API 密钥与 JWT 密钥,建议执行 chmod 600 .env
#      The file holds API keys and the JWT secret; run `chmod 600 .env`.
#
# 后端通过 python-dotenv 读取本文件;下方所有模型端点必须是 OpenAI 兼容的
# Chat Completions 接口(客户端使用 OpenAI Python SDK)。
# The backend loads this file via python-dotenv. Every model endpoint below
# must be an OpenAI-compatible **Chat Completions** API (OpenAI Python SDK).
#
# 网络请求为直连:后端忽略 HTTP_PROXY / HTTPS_PROXY / ALL_PROXY 代理设置。
# Network calls are direct: the backend ignores HTTP_PROXY/HTTPS_PROXY/ALL_PROXY.

# ============================================================================
# 01 主 LLM 模型(必填,二选一)| Main LLM (required — pick ONE template)
# ============================================================================

# --- 模板 A:DeepSeek 官方 API | Template A: DeepSeek official API -----------
# 密钥获取:platform.deepseek.com。取消注释三行并填入密钥。
# Get your key at platform.deepseek.com; uncomment the three lines and fill in.
# 可用模型（2026-09 实测）：deepseek-flash（快） / deepseek-v4-pro（强）。
# Available models (verified 2026-09): deepseek-flash / deepseek-v4-pro.
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-key-here
# LLM_MODEL=deepseek-flash
# 结构化题卡/CAT 可单独使用快速模型；未设置时自动采用
# DEEPSEEK_MODEL_LIGHT，再回退到 LLM_MODEL。
# QUIZ_MODEL=deepseek-flash
# QUIZ_SDK_MAX_RETRIES=0
# QUIZ_RETRY_MAX=2
# QUIZ_RETRY_BASE_DELAY=0.75

# --- 模板 B:通用自定义 | Template B: generic custom -------------------------
# 适用于任何提供 Chat Completions 端点的服务商。
# Works with any provider that exposes a Chat Completions endpoint:
#   OpenAI:      https://api.openai.com/v1             模型 model: gpt-4o / gpt-5.6
#   智谱 GLM:    https://open.bigmodel.cn/api/paas/v4  模型 model: glm-4.5
#   InfiniAI:    https://cloud.infini-ai.com/maas/v1   模型 model: deepseek-v4-flash
#   本地 vLLM:   http://localhost:8000/v1              模型 model: your-local-model
# 取消注释三行并填入你的信息 | Uncomment the three lines and fill in your details.
# LLM_BASE_URL=https://your-provider.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=your-model-name

# ============================================================================
# 02 LLM 调优(两套模板通用)| LLM tuning (applies to either template)
# ============================================================================
# 以下均为推荐默认值,一般无需修改。
# These are recommended defaults; usually fine as-is.

# --- 令牌与上下文预算 | Token & context budget -------------------------------
# 单轮回复 token 上限 | max tokens per reply
LLM_MAX_TOKENS=4000
# 64K 平衡档:主流模型(DeepSeek/GLM/Qwen 128K+)下既满足长周期辅导与多资料
# RAG 的上下文深度,又不让单轮输入 token 失控;模型窗口更小时请调低。
# 64K sweet spot for mainstream 128K+ models (DeepSeek/GLM/Qwen): deep enough
# for long tutoring sessions and multi-source RAG without runaway input size.
# Lower it for smaller model windows.
LLM_CONTEXT_WINDOW=65536
# 单次生成输出上限 | output token ceiling
LLM_MAX_OUTPUT_TOKENS=8000
# 压缩触发安全余量 | compaction safety margin
LLM_CONTEXT_SAFETY_MARGIN=2500
# 软压缩触发比例 | soft-compaction trigger ratio
CONTEXT_SOFT_TRIGGER_RATIO=0.72
# 硬压缩触发比例 | hard-compaction trigger ratio
CONTEXT_HARD_TRIGGER_RATIO=0.88
# 压缩后历史记录预算 | history budget after compaction
CONTEXT_HISTORY_MAX_TOKENS=24000
# 保留完整原文的近期轮数 | recent turns kept verbatim
CONTEXT_RECENT_FULL_TURNS=4
# 采样温度 | sampling temperature
LLM_TEMPERATURE=0.3

# --- 模型能力声明(适配器按实际能力调用)| Model capability flags -------------
LLM_PROVIDER=openai_compatible
LLM_RUNTIME_MODE=adapter
# 能输出推理内容 | emits reasoning content
LLM_SUPPORTS_REASONING=1
# 接受关闭思考参数 | accepts thinking-off param
LLM_SUPPORTS_DISABLE_THINKING=1
# 支持 reasoning_effort | supports reasoning_effort
LLM_SUPPORTS_REASONING_EFFORT=0
# 支持思考预算参数 | supports reasoning budget param
LLM_SUPPORTS_REASONING_BUDGET=0
# 用量中上报推理 token | usage reports reasoning tokens
LLM_REPORTS_REASONING_TOKENS=0
# 支持原生 tool 消息 | supports native tool messages
LLM_SUPPORTS_NATIVE_TOOL_MESSAGES=1

# --- 推理摘要与实时预览 | Reasoning summary & live preview --------------------
# real_summary = 模板过程摘要 + 对真实模型推理的二次提炼(每轮多一次小调用);
# adaptive / standard / detailed / compact = 仅模板过程摘要。
# real_summary = template summary + second-pass distillation of real model
# reasoning (one extra small call per turn); the others = template-only summary.
REASONING_SUMMARY_LEVEL=adaptive
# 真实推理的实时预览上限(字符):流式期间把模型 reasoning_content 逐段展示在
# 「深度思考」区。显示流不进入 LLM 上下文、不落盘、不进语音 TTS;-1 = 不限长
# (默认,完整思考过程实时可见);0 = 关闭实时预览(仅模板摘要,资料轮强制关
# 思考的旧行为);正数 N = 只实时展示前 N 字。
# Live preview cap (chars) for provider reasoning_content streamed into the
# "deep thinking" panel. Display-only: never enters LLM context, never
# persisted, never TTS'd. -1 = unlimited (default, full live thinking);
# 0 = off (template summaries only, legacy grounding behavior);
# N > 0 = stream only the first N chars.
REASONING_LIVE_MAX_CHARS=-1

# --- 工具调用上下文 | Tool-call context ----------------------------------------
# on = 工具结果投影为压缩投影 | project tool results
TOOL_CONTEXT_PROJECTION_MODE=on
# native | shadow | legacy
TOOL_MESSAGE_MODE=native
# P9 反碎片化:证据整包注入预算。旧值 2000 让 6 条证据只装下 3-4 条且溢出
# 静默丢弃;6000 配合课文级合并与溢出指针行(可用 knowledge_read 取原文)。
# P9 anti-fragmentation: whole-evidence injection budget. The old 2000 let only
# 3-4 of 6 evidences fit with silently dropped overflow; 6000 pairs with
# passage-level merging and overflow pointer rows (fetch via knowledge_read).
TOOL_CONTEXT_CURRENT_MAX_CHARS=6000
# 旧工具消息预览长度 | old tool-message preview length
TOOL_CONTEXT_OLD_PREVIEW_CHARS=400

# --- 出题校验 | Quiz verification ----------------------------------------------
# critic = 结构校验 + LLM 独立重解审题(推荐);basic = 仅确定性结构校验;
# off = 不校验(旧行为)。
# critic = structural check + independent LLM re-solve (recommended);
# basic = structural check only; off = no verification (legacy behavior).
QUIZ_VERIFY_MODE=critic

# --- 结构化评估 | Structured assessment (W3/D06) --------------------------------
# off = 旧行为(三级文本批改);shadow = 旁路计算并落盘对照,不改变判定/不写能力;
# active = 有冻结量规的开放题以结构化分析为权威判定(分数由服务端按量规权重计算)。
# off = legacy three-level grading; shadow = compute & store a comparison
# without changing the verdict or writing evaluations; active = rubric-criterion
# analysis is the authoritative grade (score computed server-side).
STRUCTURED_ASSESSMENT_MODE=off

# --- 执行器 | Executor -----------------------------------------------------------
# 工具步保留模型思考(预算充足时):1 = LOW 思考(real_summary 有真实材料,
# starving 由预算守卫与续写兜底);0 = 旧行为(工具步一律关闭思考)。
# Keep model thinking on tool steps when budget allows: 1 = LOW thinking
# (real_summary provides real material; starvation is guarded by the budget
# guard + continuation); 0 = legacy (always disable thinking on tool steps).
EXECUTOR_TOOL_THINKING=1
# 工具步输出信封上限(max_tokens 是上限不是消费)。思考型模型的隐藏推理与
# 答案共用一个信封:顶太紧会被思考吃光、触发续写重试(更费 token)。
# Output envelope for tool steps (max_tokens is a ceiling, not consumption).
# Reasoning models share one envelope between hidden thinking and the answer:
# too tight and thinking eats it, triggering continuation retries (costlier).
EXECUTOR_TOOL_MAX_OUTPUT_TOKENS=6000

# ============================================================================
# 03 视觉 / 图像模型(可选)| Vision / image model (optional)
# ============================================================================
# 学生上传题目照片时,由该模型读取图片并提取题目文本(物理图、公式等)。
# When a student uploads a problem photo, this model reads the image and
# extracts the problem text (physics diagrams, formulas, etc).
#
# 与主 LLM 相同的 Chat Completions 格式,任选服务商的视觉模型。
# Same Chat Completions format as the main LLM; pick any vision-capable model.
#   三行都填写 -> 图像识别走此通道 | fill all three -> recognition uses this channel
#   留空      -> 回退本地 tesseract OCR(chi_sim+eng;需安装 tesseract;
#                离线可用,零 API 成本)| empty -> local tesseract OCR fallback
#
# 视觉模型只用于图像识别;出题/讲解/答疑仍走上方主 LLM。
# The vision model is used ONLY for image recognition; quiz / explanation /
# answering still go through the main LLM configured above.

# 示例:智谱 GLM-4.6V | Example (GLM-4.6V on Zhipu):
# MULTIMODAL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MULTIMODAL_API_KEY=sk-your-zhipu-key-here
# MULTIMODAL_MODEL=glm-4.6v

# 示例:OpenAI GPT-4o | Example (GPT-4o on OpenAI):
# MULTIMODAL_BASE_URL=https://api.openai.com/v1
# MULTIMODAL_API_KEY=sk-your-openai-key-here
# MULTIMODAL_MODEL=gpt-4o

# 通用自定义视觉模型(取消注释并填写)| Generic custom vision model:
# MULTIMODAL_BASE_URL=https://your-provider.com/v1
# MULTIMODAL_API_KEY=sk-your-vision-key-here
# MULTIMODAL_MODEL=your-vision-model-name

# OCR 转录是提取任务:默认向视觉模型下发「关闭思考 + 最低思考强度」
# (thinking disabled + reasoning_effort low;网关 400 拒绝时自动去参重试)。
# 设为 0 恢复旧行为(不携带推理控制字段)。
# OCR transcription is extraction: by default sends "thinking disabled +
# minimal effort" (auto-retries without the params on gateway 400).
# Set 0 to restore legacy behavior (no reasoning-control fields).
MULTIMODAL_DISABLE_THINKING=1
# 单页 vision 调用最大尝试次数(API 异常与空 content 都按指数退避重试,
# 耗尽才回退本地 tesseract)。
# Max attempts per page (API errors and empty content retry with exponential
# backoff; falls back to local tesseract when exhausted).
MULTIMODAL_OCR_RETRIES=3

# ============================================================================
# 04 语义 RAG 向量检索(可选)| Semantic RAG embedding (optional)
# ============================================================================
# 向量层需显式开启,默认关闭——旧部署保持纯 BM25;向量失败自动降级 BM25。
# Opt-in and off by default: old deployments stay pure BM25; vector failures
# always degrade to BM25.
#
# 本地向量模型接口(通用,自带模型):本仓库不内置、不固定、不默认分发任何
# 本地 embedding 模型及其推理运行时依赖——local 只保留通用加载接口。部署方
# 如需离线向量轨,自行准备具备许可的模型文件与运行时依赖,并显式配置
# EMBEDDING_MODEL 或 EMBEDDING_MODEL_PATH;模型文件必须已存在于
# EMBEDDING_MODEL_PATH 或 EMBEDDING_CACHE_DIR,运行时不联网下载。
# Local vector-model interface (generic, bring-your-own): this repository
# bundles, pins, or defaults to NO local embedding model or model runtime -
# the local provider keeps only the generic loading interface. Supply your
# own licensed model files plus their runtime explicitly via EMBEDDING_MODEL /
# EMBEDDING_MODEL_PATH; model files must already exist on disk (runtime
# downloads disabled).
# EMBEDDING_PROVIDER=local          # off | local | openai
# EMBEDDING_MODEL=<your-own-local-embedding-model-id>
# EMBEDDING_MODEL_PATH=/opt/models/<your-local-embedding-model-dir>
# EMBEDDING_CACHE_DIR=/opt/model-cache/huggingface
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BATCH_SIZE=32           # 16 / 32 / 64
# EMBEDDING_MAX_THREADS=2           # OMP/MKL/torch 线程数 | ML job concurrency stays 1
#
# OpenAI 兼容替代方案 | OpenAI-compatible alternative:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-openai-key-here
# EMBEDDING_MODEL=text-embedding-3-small
#
# 公共教材向量由 backend/scripts 构建/导入;切勿复制或提交 knowledge/vector_db
# (可能包含私有运行时向量)。
# Public textbook vectors are built/imported with backend/scripts; never copy
# or commit knowledge/vector_db (it can contain private runtime vectors).
# CHROMA_DIR=knowledge/vector_db
# RAG_HYBRID=1

# --- 结构化 RAG V2 | Structured RAG V2 -----------------------------------------
# 教材刷新可复用既有 .txt,无需重做 OCR。
# Textbook refresh reuses existing .txt; no OCR redo needed.
# legacy | v2
RAG_CHUNKER_MODE=v2
# off | shadow | on
RAG_EVIDENCE_GATE=on
# 上下文预算按完整 evidence excerpt 分配,不截断标签。
# Context budget is allocated per full evidence excerpt; tags never truncated.
RAG_CONTEXT_COMPRESS=1
# 单条证据摘录上限(公式感知切句 + 定义句居中)。
# Per-evidence excerpt cap (formula-aware splitting + definition-centered).
RAG_EVIDENCE_EXCERPT_CHARS=900

# ============================================================================
# 05 辅导默认值 | Tutor defaults
# ============================================================================
# 学段由用户画像/自动识别提供(DEFAULT_GRADE 已移除,配置项无消费方)。
# Grade level comes from the user profile / auto detection (DEFAULT_GRADE was
# removed; the key has no consumer).
# Agent 推理步数硬上限(防止无限工具循环)。
# Hard cap on agent reasoning steps (prevents infinite tool loops).
AGENT_MAX_STEPS=6

# P2 教材库:上传教材 PDF 后自动解析 + 检索索引 + 构建专属知识图谱。
# 设为 0 时上传只解析+索引,跳过图谱构建(教材仍可检索)。
# P2 textbook library: uploaded PDFs are auto-parsed, indexed, and given a
# dedicated knowledge graph. With 0, uploads only parse + index (still
# searchable) and graph building is skipped.
TEXTBOOK_GRAPH_ENABLED=1
# 教材图谱章节/概念容量默认不限制;在上传页或教材详情中按教材组/单本设置。
# Graph chapter/concept capacity is unlimited by default; set per group/book
# on the upload page or textbook detail view.

# --- 扫描版 PDF 的 OCR 回退 | Scanned-PDF OCR fallback --------------------------
# 逐页渲染 → OCR → 拼回文本,复用 RAG/图谱管线。
# Renders each page → OCR → stitches text back, reusing the RAG/graph pipeline.
# PDF_OCR_MODE:auto = 仅扫描版 PDF 触发 / on = 所有 PDF 都 OCR(调试)/
# off = 禁用(扫描版 PDF 被拒)。
# auto = only scanned PDFs / on = OCR everything (debug) /
# off = disabled (scanned PDFs rejected).
# OCR 优先走 MULTIMODAL_* 视觉模型;未配则用本地 tesseract(WSL2 安装:
# sudo apt install tesseract-ocr tesseract-ocr-chi-sim)。对话/工作区/普通
# 资料库保持短重试后 tesseract 回退。
# Vision OCR uses MULTIMODAL_*; without it, local tesseract (WSL2: sudo apt
# install tesseract-ocr tesseract-ocr-chi-sim). Chat/workspace/general library
# keep short retries then tesseract fallback.
PDF_OCR_MODE=auto
# 教材库后台 OCR 页数上限(默认覆盖整本)| background page cap
PDF_OCR_MAX_PAGES=1024
# 对话/资料库同步 OCR 页数上限(保响应性)| sync cap (responsiveness)
PDF_OCR_SYNC_MAX_PAGES=20
# 页面渲染 DPI | page render DPI
PDF_OCR_DPI=200
# 教材后台 OCR 页面并发 bootstrap;管理员可在 1-64 间动态调整 | page concurrency (admin-tunable 1-64)
PDF_OCR_CONCURRENCY=20
# 教材 OCR 的失败策略/最大尝试/重试间隔/单次超时由管理员页面热更新并持久化
# 到 chat_history/settings/ocr_policy.json;默认 persistent_api:失败页约每
# 60 秒重试多模态 API,直至成功,不自动降级。此处不保存密钥。
# OCR failure policy / attempts / interval / timeout are hot-updated in the
# admin UI and persisted to chat_history/settings/ocr_policy.json; default
# persistent_api retries failed pages via the multimodal API ~every 60s until
# success, with no automatic downgrade. No secrets are stored here.

# --- M10 Skill 运行时 | Skill runtime --------------------------------------------
# start.sh / .env.example 使用完整 gated 路径 | complete gated path:
#   shadow = 只记录契约感知决策,不改变执行 | record decisions, no behavior change
#   gated  = 强制前置条件、最小澄清、分步工具 | enforce preconditions & stepwise tools
#   off    = 关闭 Skill 决策/卡片诊断 | disable Skill decision/card diagnostics
SKILL_RUNTIME_MODE=gated

# ============================================================================
# 06 追踪与服务 | Traces & server
# ============================================================================
TRACE_DIR=./traces
API_HOST=127.0.0.1
API_PORT=8000

# FRONTEND_MODE(仅 start.sh 读取):prod = 一次构建 + `next start`(压缩、
# 预取、页面加载快——默认);dev = 热重载开发服务器,适合前端开发。
# REBUILD=1 ./start.sh 强制重新生产构建。
# FRONTEND_MODE (start.sh only): prod = build once + `next start` (minified,
# prefetching, fast page loads — default); dev = hot-reload dev server for
# active frontend development. REBUILD=1 ./start.sh forces a prod rebuild.
FRONTEND_MODE=prod

# ============================================================================
# 07 M0 身份与账号系统 | Identity & account system
# ============================================================================
# AUTH_MODE:0 = 匿名/访客(单一共享学生,免登录);1 = 需要登录(每个用户
# 独立学生数据)。默认 0 开箱即用;设为 1 启用多用户注册/登录与 JWT 数据隔离。
# 0 = anonymous/guest (single shared student, no login needed);
# 1 = login required (each user gets isolated student data). Default 0 runs
# out of the box; 1 enables multi-user registration/login with JWT isolation.
AUTH_MODE=0

# 管理员引导(可选):启动时确保该账号存在且 role=admin——可上传/管理公用
# 教材库(所有账号可选用)、查看/注销账号。不配则不创建管理员。
# Admin bootstrap (optional): ensures the account exists with role=admin at
# startup — upload/manage the shared textbook library, view/close accounts.
# Omit to skip admin creation.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-in-production

# 跨会话记忆(详细 transcript 召回范围;精简 prompt memory 另按用户窗口管理):
#   workspace(默认)= 仅工作区内跨对话(公共记忆 + 同工作区会话召回);
#   all  = 该生全部会话(旧行为);
#   off  = 完全关闭跨会话召回与记忆注入。
# 独立对话不跨对话调用聊天详细记录;长期记忆只保留学生水平(M2)与语言/表达
# 风格(M8)。
# Cross-session memory (detailed-transcript recall scope; compact prompt memory
# is managed per user window separately): workspace (default) = within the
# current workspace only (shared memory + same-workspace recall); all = every
# session of the student (legacy); off = disable recall & memory injection
# entirely. Standalone chats never pull other chats' transcripts; long-term
# memory keeps only student level (M2) and language/style (M8).
CROSS_SESSION_MEMORY=workspace

# JWT 签名密钥:生产环境必须更换(任意 ≥32 字符随机串)。保留默认值时使用
# 仅开发用密钥,前端会显示警告。生成命令:
# JWT secret for signing auth tokens — MUST be changed in production (any
# random string >= 32 chars). The default is dev-only and the frontend shows
# a warning. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_JWT_SECRET=your-strong-random-secret-here

# 登录令牌有效期(天)与 bcrypt 哈希轮数。
# Auth token expiry (days) and bcrypt hashing rounds.
AUTH_TOKEN_EXPIRE_DAYS=30
AUTH_BCRYPT_ROUNDS=12

# ============================================================================
# 08 上下文工程(可选调优)| Context engineering (optional tuning)
# ============================================================================
# LLM 压缩触发前的软 token 预算(estimate_tokens 启发式估算)。
# Soft token budget before LLM compaction triggers (estimate_tokens heuristic).
# EDU_SOFT_BUDGET_TOKENS=6000
# (旧参数 legacy: EDU_SOFT_BUDGET_CHARS 仍有效,按 ~4 字符/token 折算
#  still honored, converted at ~4 chars/token)

# ============================================================================
# 09 P10 电话式语音通话(可选) | Voice call (optional)
# ============================================================================
# 电话输入固定使用浏览器原生 SpeechRecognition；推荐 Chrome/Edge。
# 后端只接收最终识别文本，不接收电话 PCM，也不运行服务器 STT。
# 浏览器识别可能由浏览器厂商的在线服务处理音频，请遵守实际服务条款。
# Call input always uses native browser Speech Recognition; Chrome/Edge are
# recommended. The backend receives final text only and runs no server STT.
# The browser vendor may process recognition audio online; follow its terms.
# Voice TTS: off | stub | melo
# VOICE_TTS_PROVIDER=off
# 先运行 deploy/install_voice.sh 准备 MeloTTS，再启用完整语音回答。
# Run deploy/install_voice.sh first to prepare MeloTTS, then enable spoken replies.
# VOICE_TTS_BASE_URL=http://127.0.0.1:8130
# VOICE_TTS_SPEED=0.9

# 10 生产部署清单 | Production deployment checklist
# ============================================================================
# 通过 nginx 同源反向代理部署(见 docs/The_Website_deployment_plan.md)?
# 上线前逐项检查 | Deploying behind nginx (same-origin reverse proxy)?
# Review each item before going live:
#
# 1) AUTH_MODE=1 —— 启用多用户登录 + 按用户数据隔离;默认 0(匿名、单一
#    共享学生)仅供本地开发。| Enable multi-user login + per-user data
#    isolation; the default 0 (anonymous) is for local dev only.
# AUTH_MODE=1
#
# 2) AUTH_JWT_SECRET —— 必须换成强随机串(生成命令见第 07 节);开发默认值
#    允许任何人伪造登录令牌。| MUST be replaced with a strong random string
#    (generator in section 07); the dev default lets anyone forge tokens.
# AUTH_JWT_SECRET=paste-generated-secret-here
#
# 3) CORS_ORIGINS —— 前端来源的逗号分隔白名单。同源 nginx 形态下浏览器不会
#    发跨域请求;此配置覆盖跨域形态并作为安全网。生产环境禁止留 *。
#    Comma-separated allowlist of frontend origins. In the same-origin nginx
#    form the browser never sends cross-origin requests; this covers the
#    cross-origin form / acts as a safety net. Never leave * in production.
# CORS_ORIGINS=https://edu-agent.invincible-summer.xyz
#
# 4) TRACE_DIR —— 可选。默认解析为锚定 <项目根>/backend/traces 的绝对路径
#    (与 cwd 无关,systemd 单元不会散落数据);相对值基于 backend/ 解析;
#    仅在想把追踪放到别处时才设绝对路径。| Optional. The default resolves
#    to an absolute path anchored at <project root>/backend/traces
#    (cwd-independent, so systemd units can't scatter data); relative values
#    resolve against backend/; set an absolute path only to relocate traces.
# TRACE_DIR=/opt/edu-agent/backend/traces
#
# 5) COMPAT_API_KEY —— OpenAI 兼容门面(/api/v1/models + /chat/completions)
#    的接入凭证,供学校平台/第三方系统按 OpenAI 兼容协议接入本 Agent。
#    不设置 = 门面关闭(端点返回 503);设置即一个强随机串:
#    Credential for the OpenAI-compatible facade. Unset = facade off
#    (endpoint returns 503); set it to one strong random string:
#    python -c "import secrets; print('COMPAT_API_KEY=' + secrets.token_urlsafe(32))"
# COMPAT_API_KEY=
# 门面会话的默认学段(接入侧无学段概念,按部署面向的学生群体设定):
# Default grade for facade sessions (callers have no grade notion; set per
# the student population this deployment serves):
# COMPAT_GRADE=高中
#
# 6) PDF_OCR_CONCURRENCY=2 —— 与 Paper Agent/myBlog 同机部署时使用保守并发,
#    避免大教材 OCR 抢占共享 CPU/内存;独占高配机器再按实测调整。
#    Conservative concurrency when co-hosted with Paper Agent/myBlog to keep
#    textbook OCR from starving shared CPU/RAM; raise on a dedicated box
#    based on measurements.
# PDF_OCR_CONCURRENCY=2
#
# 最后:chmod 600 .env —— 本文件包含 API 密钥与 JWT 密钥。
# Finally: chmod 600 .env — this file contains API keys and the JWT secret.
## SVG question illustrations: opt-in rollout; account prefs still apply.
QUIZ_SVG_ENABLED=1
# CAT 首题生成保护：最多两次逻辑尝试、共享最多 6 次 LLM 调用、90 秒截止。
# ASSESSMENT_GENERATION_MAX_ATTEMPTS=2
# ASSESSMENT_GENERATION_MAX_CALLS=6
# ASSESSMENT_GENERATION_DEADLINE_SECONDS=90
